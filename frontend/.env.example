# Formspree form id — the part after /f/ in your Formspree endpoint URL
# e.g. if your endpoint is https://formspree.io/f/abcdwxyz, set:
# VITE_FORMSPREE_ID=abcdwxyz
#
# Copy this file to ".env" (or ".env.local") and fill in your id.
# Without it, the contact form falls back to a local-only confirmation.
VITE_FORMSPREE_ID=
